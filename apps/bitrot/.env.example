# Copy to apps/bitrot/.env and fill in.

# Postgres connection string.
# Local:  postgresql://postgres@127.0.0.1:5432/bitrot?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/bitrot?schema=public"

# Signs session cookies. Must be >= 32 characters.
# Generate one with:  openssl rand -base64 32
# Required in production — the app refuses to start without it.
SESSION_SECRET=""

# How long a cached registry record stays fresh before it is re-fetched.
REGISTRY_CACHE_TTL_HOURS="6"

# Override only if you proxy the public registries.
# NPM_REGISTRY_URL="https://registry.npmjs.org"
# PYPI_REGISTRY_URL="https://pypi.org"
