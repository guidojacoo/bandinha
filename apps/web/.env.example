# Postgres (Neon/Supabase in prod, local docker in dev — see packages/db/.env.example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/h59_health"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Used to build absolute URLs (email links, etc.) — set to your Vercel URL in prod
NEXTAUTH_URL="http://localhost:3000"
