{
  "name": "mercurio",
  "version": "1.0.0",
  "private": true,
  "description": "Mercurio \u2014 a free, open-data autonomous sales agent. One URL in, a worked pipeline out. No paid APIs anywhere.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "tsx src/cli/setup.ts",
    "sell": "tsx src/cli/sell.ts",
    "agent": "tsx src/cli/agent.ts",
    "demo": "tsx src/cli/demo.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "fixtures": "tsx fixtures/server.ts",
    "fixtures:hosts": "bash fixtures/hosts.sh",
    "buyers": "tsx fixtures/buyers.ts",
    "discover": "tsx src/cli/discover.ts",
    "mock:groq": "tsx fixtures/groq-cli.ts",
    "health": "tsx src/cli/health.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "imapflow": "^1.0.164",
    "jose": "^5.9.6",
    "mailparser": "^3.7.1",
    "next": "^15.0.3",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
