{
  "name": "rainmaker",
  "version": "1.0.0",
  "private": true,
  "description": "Rainmaker — an autonomous B2B sales agent. Give it one URL; it learns what you sell, finds who buys it, writes to them, handles the replies, and works the pipeline.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "sell": "tsx src/cli/sell.ts",
    "agent": "tsx src/cli/agent.ts",
    "inbox": "tsx src/cli/inbox.ts",
    "fixtures": "tsx fixtures/server.ts",
    "demo": "tsx src/cli/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "imapflow": "^1.0.164",
    "jose": "^5.9.6",
    "mailparser": "^3.7.1",
    "next": "^15.0.3",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
