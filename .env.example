# ─── Required ────────────────────────────────────────────────────────────────

# SQLite. One file, created by `npm run setup`. No server, no account.
#
# SQLite's one ceiling is a single writer: a console and a couple of workers on
# a file is fine, a dozen workers spend their time retrying SQLITE_BUSY. That
# is the point to move, and it is one command — `npm run db:provider --
# postgres`, then `npx prisma generate` — because nothing in the schema is
# engine-specific and a test keeps it that way. Neon and Supabase both have a
# free tier that fits, so it stays free.
#
#   DATABASE_URL="postgresql://user:pass@host:5432/mercurio?sslmode=require"
DATABASE_URL="file:./data/mercurio.db"

# Signs the console's session cookie. Generate one: openssl rand -hex 32
# The console refuses to issue a session while this is the placeholder.
AUTH_SECRET="change-me-to-something-random"

# ─── The model (optional, free) ──────────────────────────────────────────────
#
# Groq's free tier: https://console.groq.com/keys
# Without it everything still runs, deterministically: the offer, the ICP and
# the copy are derived by code instead of written by a model. Blunter, still
# specific, still sourced, and it clears the same quality bar.
GROQ_API_KEY=""

# Any OpenAI-compatible endpoint. A local llama.cpp or vLLM works, which is
# the other way to keep inference free. `npm run mock:groq` serves a server
# that implements the protocol, for running the model path with no key:
#   GROQ_BASE_URL="http://127.0.0.1:8099/openai/v1"
# GROQ_BASE_URL=""
# GROQ_MODEL_LARGE="llama-3.3-70b-versatile"
# GROQ_MODEL_SMALL="llama-3.1-8b-instant"

# How much of the free tier to spend per day. The agent rations this across
# extraction, classification, composing and replying so that running out
# mid-run degrades the copy rather than stopping the agent.
# LLM_DAILY_TOKEN_LIMIT="180000"
# LLM_DAILY_REQUEST_LIMIT="900"

# Copy below this score is rewritten against the checks it failed, and the
# deterministic template competes on the same score. Raising it makes the
# agent pickier and spends more of the day's tokens on rewrites.
# MIN_MESSAGE_QUALITY="62"
# How many times the model may try before the template takes over.
# COMPOSE_ATTEMPTS="3"

# ─── Prospect discovery (all free) ───────────────────────────────────────────

# Pages that list companies in your market: an association's member list, a
# conference's exhibitor list, a "best X tools" roundup. One good page can
# yield fifty on-target domains.
# DIRECTORY_URLS="https://example.org/members,https://example.com/exhibitors"

# Companies you already want to contact. Comma-separated, or a file with one
# per line. Always tried last, and the one source that cannot fail.
# SEED_DOMAINS="acme.com,example.co"
# SEED_FILE="./leads.txt"

# A SearXNG instance for general web search. Run your own — public instances
# rate-limit hard and come and go:
#   docker run -p 8080:8080 searxng/searxng
# SEARXNG_URL="http://localhost:8080"

# Raises GitHub's search limit from 10 to 30 requests a minute. Optional, and
# the only credential in the project that buys anything.
# GITHUB_TOKEN=""

# Overpass mirrors for OpenStreetMap, tried in order.
# OVERPASS_URLS="https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"

# ─── Sending (optional) ──────────────────────────────────────────────────────
#
# Without SMTP, every send is written to ./outbox as a .eml file and nothing
# leaves the machine. That is the default and it stays the default until a
# campaign is armed in the console as well.
#
# Your server, your domain, your reputation, your responsibility as the sender
# — which is the only arrangement that is both free and lawful.
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT="587"
# SMTP_USER="you@your-company.com"
# SMTP_PASS=""

# Replies. Without IMAP they are read from ./inbox, which is how the fixture
# buyers close the loop offline.
# IMAP_HOST="imap.your-provider.com"
# IMAP_PORT="993"
# IMAP_USER="you@your-company.com"
# IMAP_PASS=""
# IMAP_MAILBOX="INBOX"

# Where the console is reachable from the outside. Used to build the
# per-recipient unsubscribe link that goes in every footer and in the
# `List-Unsubscribe` header. Leave it unset on a laptop and the footer falls
# back to "reply with the word stop", which is lawful but worse: Gmail and
# Yahoo want a one-click URL from a bulk sender. Set it the moment the console
# is reachable (a tunnel is enough).
# PUBLIC_BASE_URL="https://sales.your-company.com"

# ─── Volume and timing ───────────────────────────────────────────────────────
#
# Deliberately low. A new sending domain that emits two hundred messages on
# its first day is a new sending domain with a ruined reputation.
# DAILY_SEND_CAP="30"
# PER_DOMAIN_DAILY_CAP="2"
# MIN_HOURS_BETWEEN_TOUCHES="48"
# SEND_WINDOW_START="8"
# SEND_WINDOW_END="17"
# SEND_TZ_OFFSET_MINUTES="0"
# BLOCKED_DOMAINS=""

# ─── The worker, and scaling it ──────────────────────────────────────────────
#
# `npm start` runs the console and one worker. A worker claims a campaign's
# job, works it, and schedules the next one; start more and the work spreads,
# on this machine or any other pointed at the same database. Nothing is ever
# done twice — a campaign has exactly one tick row, and the right to run it is
# a claimed row rather than anything held in a process.
#
# How many workers `npm start` brings up, and how many jobs each does at once.
# WORKERS="1"
# WORKER_CONCURRENCY="2"

# How long a claim is good for. The holder renews it three times per lease, so
# this only has to outlast the gap between renewals, not the job. Shorter than
# the work is the one setting here that could cause a double-send.
# JOB_LEASE_MS="300000"
# JOB_MAX_ATTEMPTS="5"

# How soon a campaign is looked at again. A tick that did something comes back
# quickly; one that did not waits, and the ceiling means a campaign can never
# be quietly forgotten. Most ticks on a healthy pipeline have nothing to do,
# because the next touch is forty-eight hours away by design.
# TICK_BUSY_INTERVAL_MS="60000"
# TICK_IDLE_INTERVAL_MS="600000"
# TICK_MAX_INTERVAL_MS="3600000"

# How long after a job gives up before its campaign is tried again. A dead
# letter that needs a person to notice it is a campaign that stops silently.
# JOB_DEAD_COOLOFF_MS="3600000"
# JOB_RETENTION_DAYS="7"

# How many prospects the reply attribution reads. It runs every tick, so it is
# the one query whose cost grows with success. A window loses nothing: the
# findings need a sample of twelve, and last month is better evidence than
# February.
# LEARNING_SAMPLE="1000"

# ─── Crawler politeness ──────────────────────────────────────────────────────
#
# robots.txt is always honoured; these only tune the pace.
# HTTP_PER_HOST_DELAY_MS="1200"
# HTTP_TIMEOUT_MS="12000"
# MERCURIO_USER_AGENT="MercurioBot/1.0 (+https://github.com/mercurio-agent)"

# ─── The fixture web (demo only) ─────────────────────────────────────────────
# FIXTURE_PORT="8080"
