# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Local: postgresql://postgres@127.0.0.1:5432/rainmaker?schema=public
# Hosted (Neon/Supabase/Vercel): add ?sslmode=require
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/rainmaker?schema=public"

# Signs session cookies. Must be >= 32 characters.
#   openssl rand -base64 32
# Required in production — the app refuses to start without it.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# The model (optional, but it is the difference between good and serviceable)
# ---------------------------------------------------------------------------
# Without a key the agent still ingests, scores, sequences, sends and
# classifies replies — it writes from templates instead of composing, and
# derives the ICP heuristically.
ANTHROPIC_API_KEY=""
# RAINMAKER_MODEL="claude-opus-5-5"

# ---------------------------------------------------------------------------
# Finding prospects — configure at least one
# ---------------------------------------------------------------------------
# Comma-separated domains you already want to approach.
SEED_DOMAINS=""
# Listing pages to harvest companies from: association member lists,
# marketplace catalogues, conference sponsors, "built with" showcases.
DIRECTORY_URLS=""
# Or a search backend. Any one of these switches search prospecting on.
# BRAVE_API_KEY=""
# SERPER_API_KEY=""
# SEARXNG_URL=""

# ---------------------------------------------------------------------------
# Sending
# ---------------------------------------------------------------------------
# "dry_run" (default) writes RFC 5322 files to ./outbox and contacts nobody.
# "live" additionally requires SMTP below; credentials alone are not consent.
SEND_MODE="dry_run"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Reply polling. Without these, replies are read from ./inbox as .eml files.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"

# Who the mail is from. A real postal address is legally required on
# commercial email; the agent refuses to send a single message without one.
SENDER_NAME=""
SENDER_EMAIL=""
SENDER_POSTAL_ADDRESS=""
UNSUBSCRIBE_URL=""
MEETING_LINK=""

# ---------------------------------------------------------------------------
# Guardrails (defaults are deliberately conservative)
# ---------------------------------------------------------------------------
DAILY_SEND_CAP="40"
PER_DOMAIN_DAILY_CAP="2"
MIN_HOURS_BETWEEN_TOUCHES="48"
SEND_WINDOW_START="8"
SEND_WINDOW_END="18"
SEND_DAYS="1,2,3,4,5"
SEND_TZ_OFFSET_MINUTES="0"
BLOCKED_DOMAINS=""

# Crawler politeness.
CRAWLER_HOST_DELAY_MS="400"
# CRAWLER_USER_AGENT="RainmakerBot/1.0 (+https://your-site/bot)"

# CLI operator account (created on first run).
OPERATOR_EMAIL="operator@rainmaker.local"
OPERATOR_PASSWORD="rainmaker-local-operator"
