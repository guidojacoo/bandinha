// Mercurio data model.
//
// SQLite on purpose. The whole product has to be free and setup-free: no
// database server, no hosted tier, no account. The file lives in ./data and
// `npm run setup` creates it. Postgres remains a one-line change for anyone
// who outgrows it.
//
// Two consequences of SQLite, handled deliberately:
//   - No native enums. Status columns are String, with TypeScript union types
//     in src/core/types.ts as the single source of truth.
//   - No Json column type. Structured fields are TEXT holding JSON, read and
//     written through the typed helpers in src/lib/json.ts.
//
// Isolation rule: everything hanging off a Campaign is scoped by the session
// userId resolved server-side. A client-supplied id is never trusted.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  campaigns    Campaign[]
  suppressions Suppression[]
  clients      Client[]

  @@map("users")
}

/// Who gets the invoice.
///
/// Running the agent for somebody else and billing them for what it produced
/// is the commercial shape this makes possible, as an alternative to paying
/// $36k a year for a seat. For a single operator selling their own thing, the
/// client is themselves and the pricing is just measurement.
model Client {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  contactEmail   String?
  /// Where the invoice is addressed.
  billingAddress String?

  /// JSON: PricingTerms. Prices in cents, share in basis points.
  terms String?

  /// Shared secret for the payment webhook, which is the only thing allowed
  /// to mark a deal won. Rotatable without touching anything else.
  webhookSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  events    BillableEvent[]

  @@index([userId, createdAt])
  @@map("clients")
}

/// One proven, chargeable thing that happened.
///
/// Append-only, and raised only from facts the system holds the evidence for:
/// a message that actually sent, a reply a human wrote, a meeting a person
/// confirmed, a deal a payment closed. The unique constraints are what stop
/// the same thing being billed twice — which matters more here than anywhere
/// else in the schema, because double-billing a client is unrecoverable in a
/// way a duplicate log line is not.
model BillableEvent {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// contact_delivered | reply_received | meeting_confirmed | deal_won
  kind String
  /// When the thing happened, not when it was recorded.
  occurredAt DateTime
  /// What the system holds as proof, shown on the invoice.
  evidence String
  /// The message or deal this is derived from, for the audit trail.
  messageId String?
  /// Deal value in cents, for a share-priced win.
  valueCents Int?

  /// Stamped when it appears on an issued invoice.
  invoicedAt  DateTime?
  invoiceRef  String?

  createdAt DateTime @default(now())

  /// One charge per lead per unit kind. A four-touch sequence is one contact
  /// delivered, not four, and a prospect who replies twice is one reply.
  @@unique([clientId, leadId, kind])
  @@index([clientId, occurredAt])
  @@index([campaignId, kind])
  @@map("billable_events")
}

model Campaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Who to bill for what this campaign produces. Null means nobody is billed.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// The one input: the seller's own website.
  sourceUrl String
  name      String
  /// ingesting | running | paused | failed
  status    String  @default("ingesting")
  error     String?

  /// JSON: Offering
  offering String?
  /// JSON: Icp
  icp      String?
  /// JSON: SenderIdentity
  senderIdentity String?
  /// JSON: Partial<ComplianceConfig>
  complianceConfig String?

  /// Nothing reaches a real recipient until this is armed AND SMTP is set.
  liveSending Boolean @default(false)
  meetingLink String?

  targetLeads Int @default(25)
  minFitScore Int @default(55)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads       Lead[]
  enrollments Enrollment[]
  messages    Message[]
  deals       Deal[]
  events      Event[]
  runs        AgentRun[]
  billable    BillableEvent[]

  @@index([userId, createdAt])
  @@index([clientId, createdAt])
  @@map("campaigns")
}

model Lead {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  domain      String
  companyName String
  url         String
  /// discovered | qualifying | qualified | rejected | enrolled
  status      String @default("discovered")
  /// Which source found it, and how. Shown in the console.
  discoveredVia String

  /// JSON: LeadProfile — includes the evidence quotes outreach may use.
  profile String?
  /// JSON: FitResult, including the per-signal breakdown.
  fit      String?
  fitScore Int?
  fitBand  String?
  rejectedReason String?

  createdAt   DateTime  @default(now())
  qualifiedAt DateTime?

  contacts    Contact[]
  enrollments Enrollment[]
  deals       Deal[]
  billable    BillableEvent[]

  @@unique([campaignId, domain])
  @@index([campaignId, status])
  @@index([campaignId, fitScore])
  @@map("leads")
}

model Contact {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  email String
  name  String?
  title String?
  /// "role" (info@) or "individual"
  kind  String
  /// The page the address was published on — the lawful-basis paper trail.
  source String

  /// Deliverability pre-flight result, JSON: DeliverabilityCheck
  deliverability String?
  /// Denormalised so enrollment can filter without parsing JSON.
  deliverable Boolean @default(true)

  createdAt DateTime @default(now())

  enrollments Enrollment[]
  messages    Message[]

  @@unique([leadId, email])
  @@map("contacts")
}

model Enrollment {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sequenceName String
  /// JSON: Sequence — frozen at enrollment so changing the default cadence
  /// cannot rewrite history.
  sequence     String
  /// pending | active | replied | meeting | won | lost | unsubscribed | bounced | exhausted
  state         String @default("pending")
  nextStepIndex Int    @default(0)

  enrolledAt DateTime  @default(now())
  lastSentAt DateTime?
  repliedAt  DateTime?
  nextDueAt  DateTime?

  messages Message[]

  @@unique([contactId])
  @@index([campaignId, state, nextDueAt])
  @@map("enrollments")
}

model Message {
  id           String      @id @default(cuid())
  campaignId   String
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  /// outbound | inbound
  direction String
  /// drafted | awaiting_approval | queued | sent | failed | blocked | received
  status    String

  toEmail   String
  fromEmail String
  subject   String
  body      String

  stepIndex  Int?
  stepIntent String?
  /// "llm" | "llm-repaired" | "template" — how the copy was produced.
  composedVia String?

  /// The agent's own measured opinion of this copy, 0-100, from
  /// core/quality.ts. Stored so the console can show it and so a drop in
  /// copy quality is visible before the reply rate shows it.
  qualityScore Int?
  /// JSON: QualityCheck[] — the named checks behind that score.
  qualityChecks String?
  /// JSON: the composing attempts, for "why does it read like this?"
  attempts String?

  /// JSON: ProvenanceRecord[] — every factual claim with its source URL.
  /// A message cannot be sent unless each claim resolves to a crawled page.
  provenance String?

  blockedCode   String?
  blockedReason String?
  error         String?

  /// JSON: ReplyAnalysis, for inbound messages.
  analysis String?

  messageId String?
  inReplyTo String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([campaignId, createdAt])
  @@index([contactId, createdAt])
  @@index([campaignId, direction, status])
  @@map("messages")
}

model Deal {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// prospect | contacted | engaged | meeting_booked | proposal | won | lost
  stage      String    @default("prospect")
  meetingAt  DateTime?
  valueCents Int?
  notes      String?
  lostReason String?

  /// Set by a person, in the console. The classifier reading a reply as a
  /// meeting request is not enough to bill a client for one.
  meetingConfirmedAt DateTime?
  /// How the deal was closed: "payment" | "operator". Never by the agent.
  closedBy           String?
  /// The payment reference, when a webhook closed it.
  paymentReference   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@unique([leadId])
  @@index([campaignId, stage])
  @@map("deals")
}

/// Global per-user do-not-contact list, checked before every send.
/// Deliberately not per-campaign: someone who opts out of one campaign is out
/// of all of them, permanently.
model Suppression {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email  String
  /// unsubscribed | hard_bounce | complained | manual | not_interested | undeliverable
  reason String
  note   String?
  sourceCampaignId String?

  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@map("suppressions")
}

/// Append-only audit log of what the agent did and why.
model Event {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind    String
  level   String @default("info")
  message String
  /// JSON blob of structured detail.
  data    String?

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("events")
}

/// One tick of the orchestrator.
model AgentRun {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(true)
  error      String?
  /// JSON: TickSummary
  summary    String?

  @@index([campaignId, startedAt])
  @@map("agent_runs")
}

/// Daily LLM token accounting.
///
/// Free inference tiers are small (Groq allows roughly 200K tokens/day on the
/// larger models). The agent tracks spend so it can ration the budget across
/// a day's work and fall back to deterministic templates when it runs out,
/// rather than failing halfway through a campaign.
///
/// Two kinds of row share this table. `model = "*"` is the authoritative
/// budget for the day, and carries the per-task split that stops extraction
/// starving replies. One row per real model name is kept alongside it, purely
/// so the console can show where the day went.
model TokenLedger {
  id    String @id @default(cuid())
  /// UTC date, YYYY-MM-DD.
  day   String
  /// A model name, or "*" for the day's authoritative budget row.
  model String

  requests     Int @default(0)
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  failures     Int @default(0)

  /// JSON: Partial<Record<TaskKind, number>>, on the "*" row only.
  byTask String?

  updatedAt DateTime @updatedAt

  @@unique([day, model])
  @@map("token_ledger")
}
