// H59 Health data model.
//
// Isolation rule enforced at the application layer (see apps/web/src/lib/db.ts):
// every read/write is scoped by session userId. Never trust a client-supplied
// userId. Foreign keys here provide referential integrity, not authorization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices        Device[]
  healthSamples  HealthSample[]
  sleepSessions  SleepSession[]
  recoveryScores RecoveryScore[]
  alarms         Alarm[]
  aiInsights     AiInsight[]

  @@map("users")
}

model Device {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bleId             String // platform BLE identifier (MAC on Android, CoreBluetooth UUID on iOS)
  name              String
  firmwareVersion   String?
  hardwareVersion   String?
  /// DeviceCapabilities from @h59/shared, decoded from the cmd 0x01 response bitmap
  capabilities      Json?
  /// null = unknown until confirmed via tools/ble-probe — see docs/BLE_PROTOCOL.md
  hasVibrationMotor Boolean?
  batteryLevel      Int?
  batteryCharging   Boolean?
  lastSeenAt        DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())

  healthSamples HealthSample[]
  sleepSessions SleepSession[]
  alarms        Alarm[]

  @@unique([userId, bleId])
  @@map("devices")
}

enum HealthMetric {
  heart_rate
  spo2
  blood_pressure
  stress
  hrv
  steps
  distance
  calories
  battery
}

/// See packages/shared DataSource: never present calculated/estimated values as device readings.
enum DataSource {
  device_realtime
  device_history
  calculated
  estimated
}

model HealthSample {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ts       DateTime
  metric   HealthMetric
  value    Float
  value2   Float? // e.g. diastolic when metric = blood_pressure
  unit     String
  source   DataSource

  // Idempotent incremental sync: re-uploading an already-synced sample upserts
  // instead of duplicating (mirrors OpenH59's store.py ON DUPLICATE KEY UPDATE).
  @@unique([deviceId, metric, ts])
  @@index([userId, metric, ts])
  @@map("health_samples")
}

enum SleepStage {
  light
  deep
  rem
  awake
}

model SleepSession {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  device       Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date         String // local calendar date, YYYY-MM-DD
  startAt      DateTime
  endAt        DateTime
  totalMinutes Int
  /// 0-100, computed by @h59/scoring — never taken from the device
  sleepScore   Int?
  source       DataSource
  createdAt    DateTime   @default(now())

  stages SleepStageSegment[]

  @@unique([deviceId, date])
  @@index([userId, date])
  @@map("sleep_sessions")
}

model SleepStageSegment {
  id             String       @id @default(cuid())
  sleepSessionId String
  sleepSession   SleepSession @relation(fields: [sleepSessionId], references: [id], onDelete: Cascade)
  stage          SleepStage
  startAt        DateTime
  durationMin    Int

  @@index([sleepSessionId])
  @@map("sleep_stage_segments")
}

model RecoveryScore {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   String // YYYY-MM-DD
  score                  Int // 0-100
  /// { sleepQuality, hrv, restingHeartRate, regularity, stress, activity }
  breakdown              Json
  comparedToWeeklyAvgPct Float?
  createdAt              DateTime @default(now())

  @@unique([userId, date])
  @@map("recovery_scores")
}

model Alarm {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  device           Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  label            String
  time             String // "HH:MM", local to user.timezone
  days             Int[] // 0=Sunday .. 6=Saturday
  enabled          Boolean  @default(true)
  vibration        Boolean  @default(true)
  /// true = written to device firmware (command UNKNOWN as of this writing — see docs/BLE_PROTOCOL.md).
  /// false = delivered as a local phone notification; this is the only kind currently guaranteed to fire.
  nativeDeviceAlarm Boolean @default(false)
  windowEndTime    String? // "HH:MM" — presence marks this as a smart-alarm wake window
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@map("alarms")
}

/// Opt-in only; see docs/SECURITY.md — nothing here is populated without explicit user action.
model AiInsight {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  kind              String
  text              String
  basedOnRangeStart DateTime
  basedOnRangeEnd   DateTime

  @@index([userId, createdAt])
  @@map("ai_insights")
}
